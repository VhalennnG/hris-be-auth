flowchart TD
    Start(["Request POST /auth/login\n{email, password}"]) --> FindUser["Query tabel users\nberdasarkan email"]

    FindUser --> CheckExist{"User ditemukan?"}
    CheckExist -->|Tidak| RejectCred1["401 INVALID_CREDENTIALS\n(pesan generik, tidak bilang\n'email tidak ditemukan')"]
    RejectCred1 --> End1(["End"])

    CheckExist -->|Ya| CheckActive{"is_active = true?"}
    CheckActive -->|Tidak| RejectInactive["403 ACCOUNT_INACTIVE"]
    RejectInactive --> End2(["End"])

    CheckActive -->|Ya| HashCompare["Bandingkan password input\ndengan password_hash tersimpan\n(bcrypt.compare / argon2.verify)"]

    HashCompare --> CheckMatch{"Hash cocok?"}
    CheckMatch -->|Tidak| RejectCred2["401 INVALID_CREDENTIALS\n(pesan generik, sama seperti\nuser tidak ditemukan)"]
    RejectCred2 --> End3(["End"])

    CheckMatch -->|Ya| BuildClaim["Susun JWT claim:\nsub = user_id\nemp_id = emp_id\nrole = role\niat = now\nexp = now + 1..4 jam"]

    BuildClaim --> SignToken["Sign token dengan\nPRIVATE KEY (RS256)"]

    SignToken --> BuildResponse["Susun response:\naccess_token, token_type: Bearer,\nexpires_in, user{user_id, emp_id, role}"]

    BuildResponse --> End4(["200 Success\nreturn ke orchestrator -> FE"])

    subgraph CreateUserFlow["Sub-alur: Create User Baru (superadmin)"]
        direction TD
        CU1(["POST /auth/users\n{email, password, role, emp_id}"]) --> CU2["Validasi emp_id valid\ndi hris-be-core\n(auth -> core, langsung)"]
        CU2 --> CU3{"emp_id valid?"}
        CU3 -->|Tidak| CU4["400/404 error"]
        CU3 -->|Ya| CU5["Hash password input\n(bcrypt/argon2, cost factor sesuai)"]
        CU5 --> CU6["Insert row baru ke tabel users\n(password_hash, bukan plaintext)"]
        CU6 --> CU7(["201 Created"])
    end
